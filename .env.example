# ─── Server Network Configuration ──────────────────────────────
PORT=2222
HOST=0.0.0.0

# ─── Security & Concurrency Limits ─────────────────────────────
# Maximum concurrent visitors across the entire server
MAX_CONNECTIONS=50

# Maximum simultaneous connections allowed from a single IP address
MAX_PER_IP=5

# Session inactivity timeout in milliseconds (e.g. 600000 = 10 minutes)
IDLE_TIMEOUT_MS=600000

# ─── Persistent Host Key (Optional) ─────────────────────────────
# Path to persist the generated RSA host key on disk
# HOST_KEY_PATH=/app/data/host.key

# Alternatively, pass the private key directly as an environment variable:
# SSH_HOST_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
